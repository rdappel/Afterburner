---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'writing';
}
const {
  title,
  description = 'Ryan Appel — fullstack developer, programming instructor and game developer in Appleton, Wisconsin.',
  current = 'home',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050505" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Manrope:wght@400..800&family=JetBrains+Mono:wght@400;500;700&display=swap" />
  </head>
  <body>
    <div class="site">
      <div class="cursor" aria-hidden="true"></div>
      <Header current={current} />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      // Custom cursor (pointer devices only)
      const cursor = document.querySelector<HTMLElement>('.cursor');
      if (cursor && window.matchMedia('(hover: hover)').matches) {
        window.addEventListener('pointermove', (e) => {
          cursor.classList.add('on');
          cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
        }, { passive: true });
        document.addEventListener('pointerleave', () => cursor.classList.remove('on'));
      }
    </script>
  </body>
</html>
