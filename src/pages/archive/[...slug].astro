---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const d = post.data;
const fmtDate = (x: Date) => x.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// "Next in series" (or the next newest post)
const series = d.series ? all.filter((p) => p.data.series === d.series).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0)) : [];
const next = series.length ? series.find((p) => (p.data.part ?? 0) === (d.part ?? 0) + 1) : undefined;
const titleParts = d.title.split(':');
---
<Base title={`${d.title} — Ryan Appel`} description={d.summary} current="writing">
  <article>
    <section style="padding:100px 0 64px">
      <div class="wrap" style="display:flex;flex-direction:column;gap:32px">
        <a href="/archive/" class="mono fade-in" style="color:var(--muted);text-decoration:none">← All writing</a>
        <div class="fade-in" style="display:flex;flex-wrap:wrap;gap:10px">
          {d.series && <span class="pill"><span style="width:6px;height:6px;border-radius:50%;background:var(--lime)"></span>Series · Part {d.part} of {series.length}</span>}
          <span class="pill">{d.tag}</span>
        </div>
        <h1 class="x fade-in" style="margin:0;max-width:1180px;font-size:clamp(52px,7.4vw,116px);line-height:.9">
          {titleParts.length > 1 ? <>{titleParts.slice(0, -1).join(':')}: <span style="color:var(--lime)">{titleParts.at(-1)?.trim()}</span></> : d.title}
        </h1>
        <div class="mono fade-in" style="display:flex;flex-wrap:wrap;gap:28px;color:var(--muted);padding-top:24px;border-top:1px solid var(--line)">
          <span>By Ryan Appel</span><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>{d.readTime && <span>{d.readTime} min read</span>}
        </div>
      </div>
    </section>

    {d.diagram && (
      <section class="fade-in" style="padding:0 0 96px">
        <div class="wrap">
          <figure style="margin:0;border-radius:32px;background:var(--panel);border:1px solid var(--line);overflow:hidden">
            <svg class="diagram" viewBox="0 0 1280 520" width="100%" height="100%" role="img" aria-label="Diagram: objects on screen divided into a uniform grid of sectors; only objects sharing a sector are paired for collision checks">
              <g style="stroke:var(--line);stroke-width:1">
                {[160, 320, 480, 640, 800, 960, 1120].map((x) => <line x1={x} y1="0" x2={x} y2="520"></line>)}
                {[130, 260, 390].map((y) => <line x1="0" y1={y} x2="1280" y2={y}></line>)}
              </g>
              <rect x="320" y="130" width="160" height="130" style="fill:var(--lime);opacity:.16"></rect>
              <rect x="800" y="260" width="160" height="130" style="fill:var(--ice);opacity:.16"></rect>
              <g style="stroke:var(--muted);stroke-width:1">
                <line class="pair" x1="380" y1="190" x2="1020" y2="80"></line><line class="pair" x1="380" y1="190" x2="860" y2="320"></line>
                <line class="pair" x1="430" y1="215" x2="200" y2="440"></line><line class="pair" x1="430" y1="215" x2="1180" y2="450"></line>
                <line class="pair" x1="1020" y1="80" x2="200" y2="440"></line><line class="pair" x1="900" y1="345" x2="600" y2="60"></line>
                <line class="pair" x1="600" y1="60" x2="1180" y2="450"></line><line class="pair" x1="200" y1="440" x2="860" y2="320"></line>
                <line x1="380" y1="190" x2="430" y2="215" style="stroke:var(--lime);stroke-width:2.5"></line>
                <line x1="860" y1="320" x2="900" y2="345" style="stroke:var(--ice);stroke-width:2.5"></line>
              </g>
              <circle cx="380" cy="190" r="14" style="fill:var(--lime)"></circle><circle cx="430" cy="215" r="9" style="fill:var(--fg)"></circle>
              <circle cx="860" cy="320" r="12" style="fill:var(--ice)"></circle><circle cx="900" cy="345" r="8" style="fill:var(--fg)"></circle>
              <circle cx="1020" cy="80" r="10" style="fill:var(--muted)"></circle><circle cx="200" cy="440" r="10" style="fill:var(--muted)"></circle>
              <circle cx="1180" cy="450" r="8" style="fill:var(--muted)"></circle><circle cx="600" cy="60" r="8" style="fill:var(--muted)"></circle>
            </svg>
          </figure>
        </div>
      </section>
    )}

    <section style="padding:0 0 140px">
      <div class="wrap article-layout">
        {toc.length > 0 ? (
          <nav class="toc" aria-label="In this article">
            <span class="mono" style="color:var(--muted);padding:0 12px 12px">In this article</span>
            {toc.map((h, i) => <a href={`#${h.slug}`} data-toc={h.slug}><span>{String(i + 1).padStart(2, '0')}</span><span>{h.text}</span></a>)}
          </nav>
        ) : <div></div>}
        <div class="prose">
          <Content />
          {next && (
            <a class="next" href={`/archive/${next.id}/`}>
              <span style="display:flex;flex-direction:column;gap:10px">
                <span class="mono" style="color:var(--muted)">Next in series · Part {next.data.part}</span>
                <span class="x" style="font-size:38px">{next.data.title.split(':').pop()?.trim()}</span>
              </span>
              <span style="width:64px;height:64px;flex:none;border-radius:50%;background:var(--lime);color:var(--ink);display:grid;place-items:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            </a>
          )}
        </div>
      </div>
    </section>
  </article>

  <script>
    // Highlight the section you're reading in the table of contents
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc]'));
    const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
    if (heads.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.toc === e.target.id));
        });
      }, { rootMargin: '-20% 0px -70% 0px' });
      heads.forEach((h) => io.observe(h));
    }
  </script>
</Base>
