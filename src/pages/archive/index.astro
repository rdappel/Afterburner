---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const topics = [...new Set(posts.map((p) => p.data.tag))];
const filters = [{ id: 'all', label: `All · ${posts.length}` }, ...topics.map((t) => ({ id: slugify(t), label: `${t} · ${posts.filter((p) => p.data.tag === t).length}` }))];

const seriesDescriptions: Record<string, string> = {
  'Spatial Partitioning in a Shmup': 'Making collision detection scale when the screen is full of bullets — from a uniform grid broad phase to precise narrow-phase tests.',
  'Pixel Shaders for Games': 'Small, practical GPU effects for games — from a damage flash to outlines, dissolves, lighting, and water distortion.',
};
const series = [...new Set(posts.flatMap((post) => post.data.series ? [post.data.series] : []))]
  .map((name) => ({
    name,
    posts: posts.filter((post) => post.data.series === name).sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0)),
    description: seriesDescriptions[name] ?? 'A multi-part series of programming notes and examples.',
  }));
const word = 'Writing';
---
<Base title="Writing — Ryan Appel" description="Long-form notes on game programming, graphics and teaching code." current="writing">
  <section style="padding:120px 0 80px">
    <div class="wrap" style="display:flex;flex-direction:column;gap:40px">
      <span class="mono fade-in" style="color:var(--muted)">The blog · {posts.length} {posts.length === 1 ? 'article' : 'articles'}</span>
      <h1 class="x" style="margin:0;font-size:clamp(88px,16vw,240px);line-height:.84">
        <span class="letters">{[...word].map((l, i) => <span class="ltr" style={`--i:${i}`}>{l}</span>)}<span class="ltr" style={`--i:${word.length};color:var(--lime)`}>.</span></span>
      </h1>
      <div class="fade-in" style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:32px">
        <p style="margin:0;max-width:560px;font-size:21px;line-height:1.5">Long-form notes on game programming, graphics and teaching code — written the way I’d explain it at the whiteboard.</p>
        {topics.length > 1 && (
          <div role="group" aria-label="Filter by topic" style="display:flex;flex-wrap:wrap;gap:8px">
            {filters.map((f, i) => <button type="button" class={`chip${i === 0 ? ' on' : ''}`} data-topic={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
          </div>
        )}
      </div>
    </div>
  </section>

  {series.filter((entry) => entry.posts.length > 1).map((entry) => (
    <section style="padding:0 0 100px">
      <div class="wrap">
        <div class="series reveal">
          <div style="display:flex;flex-direction:column;gap:20px;justify-content:space-between">
            <div style="display:flex;flex-direction:column;gap:20px">
              <span class="pill" style="align-self:flex-start"><span style="width:6px;height:6px;border-radius:50%;background:var(--lime)"></span>Series · {entry.posts.length} parts</span>
              <h2 class="x" style="margin:0;font-size:clamp(40px,4.4vw,68px)">{entry.name}</h2>
              <p style="margin:0;color:var(--muted);font-size:17px;line-height:1.55">{entry.description}</p>
            </div>
            {entry.name === 'Pixel Shaders for Games' ? (
              <svg class="grid-art" width="220" height="160" viewBox="0 0 220 160" aria-hidden="true">
                <rect x="0.5" y="0.5" width="219" height="159" style="fill:none;stroke:var(--line)"></rect>
                <g style="fill:var(--ice)">
                  <rect x="48" y="38" width="18" height="18"></rect><rect x="68" y="38" width="18" height="18"></rect>
                  <rect x="38" y="58" width="18" height="18"></rect><rect x="58" y="58" width="18" height="18"></rect><rect x="78" y="58" width="18" height="18"></rect>
                  <rect x="48" y="78" width="18" height="18"></rect><rect x="68" y="78" width="18" height="18"></rect>
                  <rect x="58" y="98" width="18" height="18"></rect>
                </g>
                <g style="fill:var(--lime)">
                  <rect x="48" y="58" width="18" height="18"></rect><rect x="68" y="58" width="18" height="18"></rect>
                  <rect x="58" y="78" width="18" height="18"></rect>
                </g>
                <path d="M114 48h82M114 80h82M114 112h82" style="stroke:var(--line);stroke-width:14"></path>
                <path d="M114 48h58M114 80h74M114 112h42" style="stroke:var(--lime);stroke-width:14"></path>
                <path d="M110 140c16-20 32 20 48 0s32-20 48 0" style="fill:none;stroke:var(--ice);stroke-width:4;stroke-linecap:round"></path>
              </svg>
            ) : (
              <svg class="grid-art" width="220" height="160" viewBox="0 0 220 160" aria-hidden="true">
                <g style="stroke:var(--line);fill:none"><rect x="0.5" y="0.5" width="219" height="159"></rect><line x1="55" y1="0" x2="55" y2="160"></line><line x1="110" y1="0" x2="110" y2="160"></line><line x1="165" y1="0" x2="165" y2="160"></line><line x1="0" y1="53" x2="220" y2="53"></line><line x1="0" y1="106" x2="220" y2="106"></line></g>
                <rect x="55" y="53" width="55" height="53" style="fill:var(--lime);opacity:.25"></rect>
                <circle cx="78" cy="74" r="7" style="fill:var(--lime)"></circle><circle cx="94" cy="88" r="5" style="fill:var(--fg)"></circle>
                <circle cx="150" cy="30" r="5" style="fill:var(--muted)"></circle><circle cx="190" cy="130" r="6" style="fill:var(--muted)"></circle><circle cx="30" cy="132" r="4" style="fill:var(--muted)"></circle>
              </svg>
            )}
          </div>
          <div style="display:flex;flex-direction:column;gap:14px;justify-content:center">
            {entry.posts.map((p) => (
              <a class="step" href={`/archive/${p.id}/`}>
                <span class="x" style="font-size:52px;color:var(--lime)">{p.data.part}</span>
                <span style="display:flex;flex-direction:column;gap:6px">
                  <span class="x" style="font-size:30px">{p.data.title.split(':').pop()?.trim()}</span>
                  <span style="color:var(--muted);font-size:15px">{p.data.summary}{p.data.readTime ? ` · ${p.data.readTime} min` : ''}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}

  <section style="padding:0 0 140px">
    <div class="wrap">
      <div class="mono" style="display:flex;justify-content:space-between;color:var(--muted);margin-bottom:8px"><span>All articles</span><span>Newest first</span></div>
      <div style="border-bottom:1px solid var(--line)">
        {posts.map((p) => (
          <a class="entry reveal" href={`/archive/${p.id}/`} data-topic-of={slugify(p.data.tag)}>
            <div style="display:flex;flex-direction:column;gap:8px">
              <span class="mono">{fmtDate(p.data.date)}</span>
              {p.data.readTime && <span class="mono" style="color:var(--muted)">{p.data.readTime} min read</span>}
            </div>
            <div class="t" style="display:flex;flex-direction:column;gap:14px">
              <h3 class="x" style="margin:0;font-size:clamp(32px,3.8vw,56px);line-height:.95">{p.data.title}</h3>
              <p style="margin:0;max-width:680px;color:var(--muted);font-size:17px;line-height:1.55">{p.data.summary}</p>
            </div>
            <div style="display:flex;justify-content:flex-end;align-items:center;gap:16px">
              <span class="pill">{p.data.tag}</span>
              <span class="go"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-topic-of]'));
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      rows.forEach((r) => { r.hidden = b.dataset.topic !== 'all' && r.dataset.topicOf !== b.dataset.topic; });
    }));
  </script>
</Base>
